GDMS_ASPNETCORE_ENVIRONMENT=PreProduction
GDMS_POSTGRES_PASSWORD=change-this-postgres-password
GDMS_FIREBASE_PROJECT_ID=gdms-preprod
GDMS_FIREBASE_USE_EMULATOR=false
GDMS_FIREBASE_REMOTE_CONFIG_TEMPLATE=gdms-preprod
GDMS_API_ENABLE_HTTPS_REDIRECTION=false
GDMS_JWT_ISSUER=gdms-api-preprod
GDMS_JWT_AUDIENCE=gdms-clients-preprod
GDMS_JWT_SIGNING_KEY=change-this-preproduction-jwt-signing-key-with-at-least-32-characters
GDMS_OCR_DEFAULT_ENGINE=tesseract
GDMS_OCR_DEFAULT_LANGUAGES=spa+eng
GDMS_OCR_ALLOWED_SOURCE_ROOTS=/app/artifacts
GDMS_OCR_MAX_PAGES=100
GDMS_OCR_MAX_FILE_MB=200
GDMS_OCR_RETENTION_HOURS=72
