{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "Postgres": {
    "MainDatabase": "Host=localhost;Port=5432;Database=gdms;Username=gdms;Password=gdms_dev_password"
  },
  "Firebase": {
    "ProjectId": "gdms-local",
    "UseEmulator": true,
    "RemoteConfigTemplateName": "gdms-dev"
  },
  "Cors": {
    "PolicyName": "GdmsClient",
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5013",
      "http://localhost:8080"
    ],
    "AllowAnyOriginInDevelopment": true
  },
  "Storage": {
    "LocalRootPath": "data/storage/documents"
  },
  "SignatureProvider": {
    "Mode": "INTERNAL",
    "ProviderCode": "INTERNAL_DEV",
    "GenerateReferences": true
  },
  "Jwt": {
    "Issuer": "gdms-api-dev",
    "Audience": "gdms-clients-dev",
    "SigningKey": "",
    "AccessTokenMinutes": 120
  }
}
