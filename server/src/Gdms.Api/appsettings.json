{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Postgres": {
    "MainDatabase": "Host=postgres;Port=5432;Database=gdms;Username=gdms;Password=gdms_dev_password"
  },
  "Firebase": {
    "ProjectId": "gdms-dev",
    "UseEmulator": true,
    "RemoteConfigTemplateName": "gdms-default"
  },
  "Cors": {
    "PolicyName": "GdmsClient",
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5013",
      "http://localhost:8080"
    ],
    "AllowAnyOriginInDevelopment": true
  },
  "ApiRuntime": {
    "EnableHttpsRedirection": true
  },
  "Storage": {
    "LocalRootPath": "data/storage/documents"
  },
  "SignatureProvider": {
    "Mode": "INTERNAL",
    "ProviderCode": "INTERNAL",
    "GenerateReferences": true
  },
  "Jwt": {
    "Issuer": "gdms-api",
    "Audience": "gdms-clients",
    "SigningKey": "",
    "AccessTokenMinutes": 60
  }
}
